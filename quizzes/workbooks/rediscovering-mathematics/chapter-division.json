      "id": "sharing-equally",
      "name": "Sharing Equally",
      "instruction": "Division means sharing equally. The sign for division is ÷.",
      "questions": [
        {
          "id": "se1",
          "type": "multiple-choice",
          "prompt": "6 oranges are shared equally among 2 boys. How many does each boy get?",
          "options": ["2", "3", "4", "6"],
          "correct": "3",
          "hint": "6 ÷ 2 = 3. Each boy gets 3 oranges."
        },
        {
          "id": "se2",
          "type": "multiple-choice",
          "prompt": "What is the sign for division?",
          "options": ["+", "-", "×", "÷"],
          "correct": "÷",
          "hint": "÷ is the division sign."
        },
        {
