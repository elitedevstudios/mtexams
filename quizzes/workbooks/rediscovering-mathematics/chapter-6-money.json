{
  "id": "rediscovering-math-ch6",
  "title": "Money (Jamaican Dollars)",
  "subject": "Mathematics",
  "category": "mathematics",
  "term": 2,
  "grade": 2,
  "timeLimit": 25,
  "icon": "💰",
  "color": "secondary",
  "description": "Learn to count, add, and subtract Jamaican money",
  "curriculum": "Jamaica NSC Grade 2 - Mathematics: Measurement (Money)",
  "source": "Rediscovering Mathematics Grade 2 - Chapter 6",
  "nscObjectives": [
    "Identify Jamaican coins and notes",
    "Count money up to $100",
    "Add and subtract money amounts",
    "Solve word problems involving money"
  ],
  "sections": [
    {
      "id": "jamaican-money",
      "name": "Jamaican Coins and Notes",
      "instruction": "Jamaica uses dollars ($) and cents (¢). Let's learn about our money!",
      "questions": [
        {
          "id": "jm1",
          "type": "multiple-choice",
          "prompt": "Which coin is worth the MOST?",
          "options": ["$1 coin", "$5 coin", "$10 coin", "$20 coin"],
          "correct": "$20 coin",
          "hint": "The bigger the number, the more it's worth!"
        },
        {
          "id": "jm2",
          "type": "multiple-choice",
          "prompt": "How many $10 coins make $50?",
          "options": ["3", "4", "5", "6"],
          "correct": "5",
          "hint": "Count by 10s: 10, 20, 30, 40, 50"
        },
        {
          "id": "jm3",
          "type": "multiple-choice",
          "prompt": "How many $5 coins make $20?",
          "options": ["2", "3", "4", "5"],
          "correct": "4",
          "hint": "Count by 5s: 5, 10, 15, 20"
        },
        {
          "id": "jm4",
          "type": "multiple-choice",
          "prompt": "Which is worth MORE: three $10 coins or two $20 coins?",
          "options": ["Three $10 coins ($30)", "Two $20 coins ($40)", "They are equal"],
          "correct": "Two $20 coins ($40)",
          "hint": "3 × $10 = $30, and 2 × $20 = $40"
        },
        {
          "id": "jm5",
          "type": "multi-select",
          "prompt": "Select ALL the ways to make $20:",
          "options": ["Two $10 coins", "Four $5 coins", "Twenty $1 coins", "One $20 coin", "Three $5 coins"],
          "correct": ["Two $10 coins", "Four $5 coins", "Twenty $1 coins", "One $20 coin"],
          "hint": "Add up each option to see if it equals $20."
        }
      ]
    },
    {
      "id": "counting-money",
      "name": "Counting Money",
      "instruction": "When counting money, start with the biggest coins first!",
      "questions": [
        {
          "id": "cm1",
          "type": "multiple-choice",
          "prompt": "Morgan has: $10 + $10 + $5. How much money does she have?",
          "options": ["$15", "$20", "$25", "$30"],
          "correct": "$25",
          "hint": "10 + 10 = 20, then 20 + 5 = 25"
        },
        {
          "id": "cm2",
          "type": "multiple-choice",
          "prompt": "Count the money: $20 + $10 + $5 + $1",
          "options": ["$26", "$31", "$36", "$41"],
          "correct": "$36",
          "hint": "Add from biggest to smallest: 20 + 10 + 5 + 1"
        },
        {
          "id": "cm3",
          "type": "multiple-choice",
          "prompt": "Dad has two $20 coins and one $10 coin. How much money does he have?",
          "options": ["$30", "$40", "$50", "$60"],
          "correct": "$50",
          "hint": "20 + 20 + 10 = ?"
        },
        {
          "id": "cm4",
          "type": "multiple-choice",
          "prompt": "Morgan saved: $10 + $10 + $10 + $5 + $5. How much did she save?",
          "options": ["$35", "$40", "$45", "$50"],
          "correct": "$40",
          "hint": "Three $10 = $30, two $5 = $10. Total = $40"
        },
        {
          "id": "cm5",
          "type": "text-input",
          "prompt": "Count: $20 + $20 + $5 + $5 = ?",
          "correct": "50",
          "hint": "Add the $20s first, then add the $5s."
        }
      ]
    },
    {
      "id": "adding-money",
      "name": "Adding Money",
      "instruction": "When we buy things, we add up the prices to find the total cost.",
      "questions": [
        {
          "id": "am1",
          "type": "multiple-choice",
          "prompt": "A pencil costs $15 and an eraser costs $10. How much for both?",
          "options": ["$5", "$15", "$25", "$35"],
          "correct": "$25",
          "hint": "$15 + $10 = ?"
        },
        {
          "id": "am2",
          "type": "multiple-choice",
          "prompt": "A juice box costs $30 and a bun costs $25. What is the total?",
          "options": ["$5", "$45", "$55", "$65"],
          "correct": "$55",
          "hint": "$30 + $25 = ?"
        },
        {
          "id": "am3",
          "type": "multiple-choice",
          "prompt": "Morgan buys a book for $45 and crayons for $32. How much does she spend?",
          "options": ["$13", "$67", "$77", "$87"],
          "correct": "$77",
          "hint": "Add: 45 + 32. Add ones first (5+2=7), then tens (40+30=70)."
        },
        {
          "id": "am4",
          "type": "multiple-choice",
          "prompt": "A toy car costs $38 and a ball costs $24. What is the total cost?",
          "options": ["$14", "$52", "$62", "$72"],
          "correct": "$62",
          "hint": "$38 + $24 = ?"
        },
        {
          "id": "am5",
          "type": "text-input",
          "prompt": "A snack costs $18 and a drink costs $22. What is the total?",
          "correct": "40",
          "hint": "18 + 22 = ?"
        }
      ]
    },
    {
      "id": "subtracting-money",
      "name": "Subtracting Money (Change)",
      "instruction": "When we pay more than the cost, we get change back!",
      "questions": [
        {
          "id": "sm1",
          "type": "multiple-choice",
          "prompt": "Morgan pays $20 for a snack that costs $15. How much change does she get?",
          "options": ["$3", "$4", "$5", "$35"],
          "correct": "$5",
          "hint": "$20 - $15 = ?"
        },
        {
          "id": "sm2",
          "type": "multiple-choice",
          "prompt": "Dad pays $50 for groceries that cost $35. What is his change?",
          "options": ["$5", "$10", "$15", "$85"],
          "correct": "$15",
          "hint": "$50 - $35 = ?"
        },
        {
          "id": "sm3",
          "type": "multiple-choice",
          "prompt": "A toy costs $42. Morgan pays with $50. How much change?",
          "options": ["$6", "$7", "$8", "$92"],
          "correct": "$8",
          "hint": "$50 - $42 = ?"
        },
        {
          "id": "sm4",
          "type": "multiple-choice",
          "prompt": "Mom pays $100 for a dress that costs $75. What change does she receive?",
          "options": ["$15", "$25", "$35", "$175"],
          "correct": "$25",
          "hint": "$100 - $75 = ?"
        },
        {
          "id": "sm5",
          "type": "text-input",
          "prompt": "A book costs $28. You pay $30. How much change do you get?",
          "correct": "2",
          "hint": "$30 - $28 = ?"
        }
      ]
    },
    {
      "id": "money-word-problems",
      "name": "Money Word Problems",
      "instruction": "Read each problem carefully. Decide if you need to add or subtract!",
      "questions": [
        {
          "id": "mwp1",
          "type": "multiple-choice",
          "prompt": "Morgan has $35. Her grandmother gives her $20 more. How much does Morgan have now?",
          "options": ["$15", "$45", "$55", "$65"],
          "correct": "$55",
          "hint": "She gets MORE money, so we ADD: $35 + $20"
        },
        {
          "id": "mwp2",
          "type": "multiple-choice",
          "prompt": "Dad had $80. He spent $45 on food. How much money does he have left?",
          "options": ["$25", "$35", "$45", "$125"],
          "correct": "$35",
          "hint": "He SPENT money, so we SUBTRACT: $80 - $45"
        },
        {
          "id": "mwp3",
          "type": "multiple-choice",
          "prompt": "Morgan wants to buy a doll for $60. She has saved $42. How much more does she need?",
          "options": ["$8", "$18", "$28", "$102"],
          "correct": "$18",
          "hint": "Find the difference: $60 - $42 = ?"
        },
        {
          "id": "mwp4",
          "type": "multiple-choice",
          "prompt": "Chris has $25 and Morgan has $30. How much do they have together?",
          "options": ["$5", "$45", "$55", "$65"],
          "correct": "$55",
          "hint": "Together means ADD: $25 + $30"
        },
        {
          "id": "mwp5",
          "type": "text-input",
          "prompt": "A notebook costs $22 and a pen costs $8. If Morgan has $40, how much will she have left after buying both?",
          "correct": "10",
          "hint": "First find the total cost ($22 + $8 = $30), then subtract from $40."
        }
      ]
    },
    {
      "id": "adding-dollars-cents",
      "name": "Adding Money (Dollars and Cents)",
      "instruction": "Money is written with dollars, a dot, then cents. Add the cents first, then the dollars!",
      "questions": [
        {
          "id": "adc1",
          "type": "multiple-choice",
          "prompt": "$10.34 + $56.12 = ?",
          "options": ["$66.46", "$66.44", "$65.46", "$67.46"],
          "correct": "$66.46",
          "hint": "Add the cents: 34 + 12 = 46. Add the dollars: 10 + 56 = 66."
        },
        {
          "id": "adc2",
          "type": "multiple-choice",
          "prompt": "$71.25 + $10.14 = ?",
          "options": ["$80.39", "$81.29", "$81.39", "$82.39"],
          "correct": "$81.39",
          "hint": "Cents: 25 + 14 = 39. Dollars: 71 + 10 = 81."
        },
        {
          "id": "adc3",
          "type": "multiple-choice",
          "prompt": "$2.45 + $6.30 = ?",
          "options": ["$8.65", "$8.75", "$8.85", "$9.75"],
          "correct": "$8.75",
          "hint": "Cents: 45 + 30 = 75. Dollars: 2 + 6 = 8."
        },
        {
          "id": "adc4",
          "type": "multiple-choice",
          "prompt": "$6.04 + $3.03 = ?",
          "options": ["$9.07", "$9.70", "$9.17", "$8.07"],
          "correct": "$9.07",
          "hint": "Cents: 04 + 03 = 07. Dollars: 6 + 3 = 9."
        },
        {
          "id": "adc5",
          "type": "text-input",
          "prompt": "$3.15 + $4.10 = ? (write your answer like 7.25)",
          "correct": "7.25",
          "hint": "Cents: 15 + 10 = 25. Dollars: 3 + 4 = 7."
        }
      ]
    },
    {
      "id": "subtracting-dollars-cents",
      "name": "Subtracting Money (Dollars and Cents)",
      "instruction": "Subtract the cents first, then the dollars. Keep the dot in line!",
      "questions": [
        {
          "id": "sdc1",
          "type": "multiple-choice",
          "prompt": "$36.74 - $13.32 = ?",
          "options": ["$23.42", "$23.32", "$22.42", "$24.42"],
          "correct": "$23.42",
          "hint": "Cents: 74 - 32 = 42. Dollars: 36 - 13 = 23."
        },
        {
          "id": "sdc2",
          "type": "multiple-choice",
          "prompt": "$43.96 - $21.25 = ?",
          "options": ["$22.71", "$22.61", "$21.71", "$23.71"],
          "correct": "$22.71",
          "hint": "Cents: 96 - 25 = 71. Dollars: 43 - 21 = 22."
        },
        {
          "id": "sdc3",
          "type": "multiple-choice",
          "prompt": "$57.65 - $32.31 = ?",
          "options": ["$25.34", "$25.24", "$24.34", "$26.34"],
          "correct": "$25.34",
          "hint": "Cents: 65 - 31 = 34. Dollars: 57 - 32 = 25."
        },
        {
          "id": "sdc4",
          "type": "multiple-choice",
          "prompt": "$8.88 - $6.23 = ?",
          "options": ["$2.65", "$2.55", "$3.65", "$2.75"],
          "correct": "$2.65",
          "hint": "Cents: 88 - 23 = 65. Dollars: 8 - 6 = 2."
        },
        {
          "id": "sdc5",
          "type": "multiple-choice",
          "prompt": "$1 - 20¢ = ?",
          "options": ["70¢", "80¢", "90¢", "120¢"],
          "correct": "80¢",
          "hint": "$1 is 100¢. 100¢ - 20¢ = 80¢."
        }
      ]
    },
    {
      "id": "cents-and-dollars",
      "name": "Changing Cents and Dollars",
      "instruction": "Remember: 100 cents (100¢) make one dollar ($1).",
      "questions": [
        {
          "id": "cad1",
          "type": "multiple-choice",
          "prompt": "100¢ is the same as ___.",
          "options": ["$1", "$10", "$100", "10¢"],
          "correct": "$1",
          "hint": "One hundred cents make one dollar."
        },
        {
          "id": "cad2",
          "type": "multiple-choice",
          "prompt": "How many cents are in $1?",
          "options": ["10¢", "50¢", "100¢", "1000¢"],
          "correct": "100¢",
          "hint": "$1 = 100¢."
        },
        {
          "id": "cad3",
          "type": "multiple-choice",
          "prompt": "$0.75 written in cents is ___.",
          "options": ["7¢", "75¢", "750¢", "70¢"],
          "correct": "75¢",
          "hint": "The numbers after the dot are the cents: 75."
        },
        {
          "id": "cad4",
          "type": "multiple-choice",
          "prompt": "120¢ written in dollars is ___.",
          "options": ["$1.20", "$12.00", "$0.12", "$120"],
          "correct": "$1.20",
          "hint": "100¢ = $1, and 20¢ left over. So $1.20."
        },
        {
          "id": "cad5",
          "type": "multiple-choice",
          "prompt": "When there are no dollars, we put a ___ before the dot.",
          "options": ["zero", "one", "dollar sign", "comma"],
          "correct": "zero",
          "hint": "Like $0.75 — a zero shows there are no whole dollars."
        }
      ]
    },
    {
      "id": "comparing-money",
      "name": "Comparing Amounts of Money",
      "instruction": "To compare money, look at the dollars first. If the dollars are the same, then compare the cents.",
      "questions": [
        {
          "id": "cmp1",
          "type": "multiple-choice",
          "prompt": "Which amount is GREATER: $34.40 or $47.15?",
          "options": ["$34.40", "$47.15", "They are equal"],
          "correct": "$47.15",
          "hint": "Compare the dollars: 47 is more than 34."
        },
        {
          "id": "cmp2",
          "type": "multiple-choice",
          "prompt": "Which amount is GREATER: $53.30 or $53.85?",
          "options": ["$53.30", "$53.85", "They are equal"],
          "correct": "$53.85",
          "hint": "The dollars are the same (53). Compare cents: 85 is more than 30."
        },
        {
          "id": "cmp3",
          "type": "multiple-choice",
          "prompt": "Which amount is SMALLER: $1.80 or $3.70?",
          "options": ["$1.80", "$3.70", "They are equal"],
          "correct": "$1.80",
          "hint": "Compare the dollars: 1 is less than 3."
        },
        {
          "id": "cmp4",
          "type": "multiple-choice",
          "prompt": "Which amount is GREATER: $42.37 or $40.30?",
          "options": ["$42.37", "$40.30", "They are equal"],
          "correct": "$42.37",
          "hint": "The dollars 42 are more than 40."
        },
        {
          "id": "cmp5",
          "type": "multiple-choice",
          "prompt": "Which is the GREATEST amount: $70.45, $70.90, or $68.85?",
          "options": ["$70.45", "$70.90", "$68.85"],
          "correct": "$70.90",
          "hint": "$70 amounts beat $68. Then between the $70s, 90¢ is more than 45¢."
        }
      ]
    },
    {
      "id": "shopping-and-change",
      "name": "Shopping and Change",
      "instruction": "At the shop we add up prices, and we get change back when we pay more than the total.",
      "questions": [
        {
          "id": "sc1",
          "type": "multiple-choice",
          "prompt": "3 rulers cost $20 each. How much for all 3 rulers?",
          "options": ["$23", "$40", "$60", "$80"],
          "correct": "$60",
          "hint": "$20 + $20 + $20 = $60."
        },
        {
          "id": "sc2",
          "type": "multiple-choice",
          "prompt": "John buys 3 erasers that cost $12 each. How much does he spend?",
          "options": ["$15", "$24", "$36", "$48"],
          "correct": "$36",
          "hint": "$12 + $12 + $12 = $36."
        },
        {
          "id": "sc3",
          "type": "multiple-choice",
          "prompt": "A pencil costs $5 and a pack of crayons costs $30. The teacher gives you $50. How much change should you get?",
          "options": ["$5", "$15", "$25", "$35"],
          "correct": "$15",
          "hint": "First add: $5 + $30 = $35. Then $50 - $35 = $15."
        },
        {
          "id": "sc4",
          "type": "multiple-choice",
          "prompt": "Kimani buys a pack of crayons ($30), 2 pencils ($5 each), and an eraser ($12). How much does he spend?",
          "options": ["$42", "$47", "$52", "$57"],
          "correct": "$52",
          "hint": "$30 + $5 + $5 + $12 = $52."
        },
        {
          "id": "sc5",
          "type": "multiple-choice",
          "prompt": "Tom buys 1 pineapple for $225 and 3 coconuts for $300. How much does he pay in all?",
          "options": ["$425", "$525", "$625", "$75"],
          "correct": "$525",
          "hint": "$225 + $300 = $525."
        }
      ]
    }
  ]
}
